{
	"schemaVersion": 1,
	"id": "quake",
	"version": "${version}",
	"name": "Quake",
	"description": "Quake 미니게임 서버 전용 클라이언트 모드. Quake 플러그인이 있는 서버에 접속했을 때만 동작합니다.",
	"authors": [
		"MCHDF"
	],
	"contact": {
		"homepage": "https://github.com/MCHDF/quake-mod",
		"sources": "https://github.com/MCHDF/quake-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/quake/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"moe.mchdf.quake.QuakeMod"
		],
		"client": [
			"moe.mchdf.quake.client.QuakeModClient"
		]
	},
	"mixins": [
		"quake.mixins.json",
		{
			"config": "quake.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}
